# --- Required -----------------------------------------------------------------
# Postgres connection string used by the app at runtime.
# Neon: use the *pooled* connection string (host contains "-pooler").
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/linkpulse"

# Secret used to sign session cookies (min. 32 chars). Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string-of-32-plus-chars"

# Public base URL used to build short links (no trailing slash).
# On Vercel this falls back to https://$VERCEL_PROJECT_PRODUCTION_URL when unset.
APP_URL="http://localhost:3300"

# --- Optional -----------------------------------------------------------------
# Direct (non-pooled) connection for `prisma migrate` (recommended with Neon).
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Enables "Continue with GitHub" when both are set.
# Callback URL: $APP_URL/api/auth/github/callback
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Protects /api/cron/reset-demo (Vercel Cron sends it as a Bearer token).
# CRON_SECRET=""

# Rate limiter backend: "postgres" (default, works across serverless instances) or "memory".
# RATE_LIMIT_STORE="postgres"
